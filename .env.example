# Copy to .env and fill. NOTHING in this file's real counterpart is ever committed.

# The agent. Claude Code accepts an OpenRouter proxy: set BASE_URL and AUTH_TOKEN (Bearer),
# and leave ANTHROPIC_API_KEY explicitly empty (the CLI sends x-api-key when it is set).
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# recall arm: a Postgres DSN whose database is disposable and owned by this benchmark.
RECALL_DSN=

# docker/compose.yaml refuses to start without a deployment supplied database password.
# Keep it different from every other environment and do not commit the real value.
POSTGRES_PASSWORD=

# mempalace arm: its own virtualenv and a SHORT palace path. Neither is ever guessed, and the
# path must stay short because onnxruntime fails to load its DLL from a deep path on Windows,
# which chromadb then re-raises as "the onnxruntime python package is not installed".
MEMPALACE_VENV=
MEMPALACE_PALACE_ROOT=
# cachly arm: a dedicated Brain instance, one API credential, and the vendor supplied bulk loader.
# The loader command is kept out of the frozen config and receives the corpus through environment
# variables documented in adapters/cachly/VENDOR_REVIEW.md.
CACHLY_BRAIN_INSTANCE_ID=
CACHLY_API_KEY=
CACHLY_JWT=
CACHLY_API_URL=
AMB_CACHLY_BULK_INGEST_COMMAND=
# SaaS arms. Absent keys make the harness refuse that arm at startup rather than fake it.
MEM0_API_KEY=
SUPERMEMORY_API_KEY=

# zep/cognee arms run locally via docker compose; their extraction LLM traffic goes through
# the harness's LiteLLM proxy so ingestion tokens are metered per arm.
OPENROUTER_API_KEY=
