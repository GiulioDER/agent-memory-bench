# Copy to .env and fill. NOTHING in this file's real counterpart is ever committed.

# The agent. Claude Code accepts an OpenRouter proxy: set BASE_URL and AUTH_TOKEN (Bearer),
# and leave ANTHROPIC_API_KEY explicitly empty (the CLI sends x-api-key when it is set).
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# recall arm: a Postgres DSN whose database is disposable and owned by this benchmark.
RECALL_DSN=

# docker/compose.yaml refuses to start without a deployment supplied database password.
# Keep it different from every other environment and do not commit the real value.
POSTGRES_PASSWORD=

# mempalace arm: its own virtualenv and a SHORT palace path. Neither is ever guessed, and the
# path must stay short because onnxruntime fails to load its DLL from a deep path on Windows,
# which chromadb then re-raises as "the onnxruntime python package is not installed".
MEMPALACE_VENV=
MEMPALACE_PALACE_ROOT=
# cachly arm: a dedicated Brain instance, one API credential, and the vendor supplied bulk loader.
# The loader command is kept out of the frozen config and receives the corpus through environment
# variables documented in adapters/cachly/VENDOR_REVIEW.md.
CACHLY_BRAIN_INSTANCE_ID=
CACHLY_API_KEY=
CACHLY_JWT=
CACHLY_API_URL=
AMB_CACHLY_BULK_INGEST_COMMAND=
# Graphiti arm: point at the official checkout's mcp_server directory, and use a dedicated
# Neo4j database or graph namespace. The adapter maps the selected key to Graphiti's OPENAI client
# variables, so these values are never committed or copied into a recorded config file.
GRAPHITI_MCP_DIR=
GRAPHITI_OPENAI_API_KEY=
GRAPHITI_OPENROUTER_API_KEY=
GRAPHITI_OPENAI_API_URL=
GRAPHITI_EMBEDDER_API_KEY=
GRAPHITI_EMBEDDER_API_URL=https://api.openai.com/v1
GRAPHITI_LLM_PROVIDER=openai
GRAPHITI_MODEL_NAME=
GRAPHITI_LLM_STRUCTURED_OUTPUT_MODE=json_schema
GRAPHITI_EMBEDDER_PROVIDER=openai
GRAPHITI_EMBEDDER_MODEL=
GRAPHITI_VOYAGE_API_KEY=
GRAPHITI_NEO4J_URI=
GRAPHITI_NEO4J_USER=
GRAPHITI_NEO4J_PASSWORD=
GRAPHITI_NEO4J_DATABASE=
GRAPHITI_SEMAPHORE_LIMIT=
# Set GRAPHITI_DATABASE_PROVIDER=falkordb on VPS2 to use its existing Redis compatible service.
GRAPHITI_DATABASE_PROVIDER=neo4j
GRAPHITI_FALKORDB_URI=redis://localhost:6379
GRAPHITI_FALKORDB_USERNAME=
GRAPHITI_FALKORDB_PASSWORD=
GRAPHITI_FALKORDB_DATABASE=default_db
# SaaS arms. Absent keys make the harness refuse that arm at startup rather than fake it.
MEM0_API_KEY=
SUPERMEMORY_API_KEY=

# Supermemory arm. Use the official claude-supermemory checkout and the key printed by
# Supermemory Local. SUPERMEMORY_API_URL defaults to http://localhost:6767.
SUPERMEMORY_PLUGIN_DIR=
SUPERMEMORY_CC_API_KEY=
SUPERMEMORY_API_URL=
SUPERMEMORY_LOCAL_MODEL=

# Claude-Mem arm. Point this at the official claude-mem checkout or its plugin directory. The
# qualification adapter pins v13.24.0 and uses its OpenRouter observer provider.
CLAUDE_MEM_PLUGIN_DIR=
CLAUDE_MEM_OPENROUTER_API_KEY=
CLAUDE_MEM_BENCHMARK_WORKER_PORT=

# zep/cognee arms run locally via docker compose; their extraction LLM traffic goes through
# the harness's LiteLLM proxy so ingestion tokens are metered per arm.
OPENROUTER_API_KEY=

# Secure production execution. Provider credentials belong only to the trusted broker process.
# The participant receives the two opaque, short-lived capabilities below through the controller.
AMB_BROKER_SIGNING_SECRET=
AMB_BROKER_TOKEN_TTL_S=3600
AMB_BROKER_RUN_ID=
AMB_BROKER_ARM=
AMB_BROKER_NAMESPACE=
AMB_BROKER_UPSTREAM_URL=
AMB_BROKER_UPSTREAM_CREDENTIAL=
AMB_BROKER_UPSTREAM_ALLOWLIST=
AMB_MODEL_BROKER_UPSTREAM_URL=https://openrouter.ai/api/v1/messages
AMB_MEMORY_BROKER_UPSTREAM_URL=http://graphiti-mcp:8000/mcp
AMB_MEMORY_BROKER_UPSTREAM_ALLOWLIST=http://graphiti-mcp:8000/
AMB_EGRESS_PROXY_URL=http://egress-proxy:3128
AMB_EGRESS_ALLOWED_HOSTS=api.openai.com,openrouter.ai
AMB_CAPABILITY_MODEL=
AMB_CAPABILITY_MEMORY=
AMB_MODEL_BROKER_URL=http://model-broker:8080
AMB_MEMORY_BROKER_URL=http://memory-broker:8080
AMB_PARTICIPANT_IMAGE=agent-memory-bench-participant
AMB_PARTICIPANT_IMAGE_DIGEST=
AMB_CHECKER_IMAGE=agent-memory-bench-checker
AMB_CHECKER_IMAGE_DIGEST=
AMB_NETWORK_POLICY_DIGEST=
