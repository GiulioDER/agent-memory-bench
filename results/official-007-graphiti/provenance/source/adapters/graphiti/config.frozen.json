{
  "product": "Graphiti",
  "upstream_repo": "https://github.com/getzep/graphiti.git",
  "upstream_ref": "4bd728790e836950c3922e84f6f989f1380f54f2",
  "mcp_server_version": "1.1.0",
  "package_pin": "mcp-server==1.1.0; graphiti-core>=0.30.1",
  "server_name": "graphiti",
  "mcp_dir_env": "GRAPHITI_MCP_DIR",
  "uv_command": "uv",
  "tool_prefix": "mcp__graphiti__",
  "allowed_tools": [
    "search_memory_facts",
    "search_nodes",
    "get_episodes",
    "get_episode_entities",
    "get_entity_edge",
    "get_status"
  ],
  "search_sentence": "This project's Graphiti memory is a temporal knowledge graph; search it with `mcp__graphiti__search_memory_facts` before acting.",
  "llm_key_envs": [
    "GRAPHITI_OPENAI_API_KEY",
    "GRAPHITI_OPENROUTER_API_KEY"
  ],
  "llm_provider_env": "GRAPHITI_LLM_PROVIDER",
  "llm_provider_default": "openai",
  "llm_api_url_env": "GRAPHITI_OPENAI_API_URL",
  "embedder_api_key_env": "GRAPHITI_EMBEDDER_API_KEY",
  "embedder_api_url_env": "GRAPHITI_EMBEDDER_API_URL",
  "llm_model_env": "GRAPHITI_MODEL_NAME",
  "llm_structured_output_env": "GRAPHITI_LLM_STRUCTURED_OUTPUT_MODE",
  "embedder_provider_env": "GRAPHITI_EMBEDDER_PROVIDER",
  "embedder_provider_default": "openai",
  "embedder_model_env": "GRAPHITI_EMBEDDER_MODEL",
  "voyage_api_key_env": "GRAPHITI_VOYAGE_API_KEY",
  "neo4j_uri_env": "GRAPHITI_NEO4J_URI",
  "neo4j_user_env": "GRAPHITI_NEO4J_USER",
  "neo4j_password_env": "GRAPHITI_NEO4J_PASSWORD",
  "neo4j_database_env": "GRAPHITI_NEO4J_DATABASE",
  "database_provider_env": "GRAPHITI_DATABASE_PROVIDER",
  "database_provider_default": "neo4j",
  "falkordb_uri_env": "GRAPHITI_FALKORDB_URI",
  "falkordb_username_env": "GRAPHITI_FALKORDB_USERNAME",
  "falkordb_password_env": "GRAPHITI_FALKORDB_PASSWORD",
  "falkordb_database_env": "GRAPHITI_FALKORDB_DATABASE",
  "semaphore_env": "GRAPHITI_SEMAPHORE_LIMIT",
  "lockfile": "mcp_server/uv.lock",
  "transport": "stdio",
  "broker_request_timeout_seconds": 180,
  "ingest_timeout_seconds": 0
}
