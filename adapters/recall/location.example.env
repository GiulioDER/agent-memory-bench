# Where the recall arm's corpus and server live. Copy into the file
# scripts/launch_official.sh sources ($HOME/amb-secrets.env by default) and fill in.
#
# These are deliberately NOT in adapters/recall/config.frozen.json. That file is published
# with every run, and an ssh alias plus a service account's paths plus the location of a
# production .env is worth something to a reader with no credential attached. The frozen
# config names each variable instead; adapters/mempalace/config.frozen.json has always done
# it this way. Location cannot change what a memory product returns, so nothing a reader
# needs in order to check the experiment is lost by keeping it out.
#
# Nothing here has a default. A wrong host answers confidently instead of failing.

RECALL_DSN=postgresql:///?host=/path/to/socket/dir&port=5432&dbname=amb_bench
AMB_RECALL_SSH_HOST=my-bench-host
AMB_RECALL_REMOTE_ROOT=/srv/amb-bench
AMB_RECALL_REMOTE_PYTHON=/srv/amb-bench/.venv/bin/python
AMB_RECALL_REMOTE_ENV_FILE=/srv/recall/.env
