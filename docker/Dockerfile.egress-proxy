# Trusted allowlist proxy. It contains no benchmark corpus or participant code.
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

WORKDIR /app
COPY scripts/egress_proxy.py /app/egress_proxy.py

# Numeric nobody style identity needs no passwd or group entry and avoids collisions with the
# base image's reserved `proxy` group.
USER 65532:65532
CMD ["python", "/app/egress_proxy.py"]
