# The participant image receives only an explicit workspace archive at runtime.
# The repository, benchmark corpus, oracle files and git history are never copied into it.
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

ARG CLAUDE_CODE_VERSION=2.1.221
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

RUN mkdir -p /workspace /session \
    && chown -R 65532:65532 /workspace /session
WORKDIR /workspace

# The isolation runner supplies the command and user explicitly. No entrypoint is defined so the
# image can be held with `sleep infinity` while the runner transfers the input archive.
